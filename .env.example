# ==========================================
# Variables de Entorno - Finanzas Personales
# ==========================================
# Copiar este archivo a .env y completar los valores

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=finanzas_db
POSTGRES_USER=finanzas_user
POSTGRES_PASSWORD=finanzas_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL (para Django)
DATABASE_URL=postgres://finanzas_user:finanzas_password@db:5432/finanzas_db

# Redis (opcional, para Celery)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Frontend
# ── Desarrollo local (QR en celular): usa la IP de tu PC ──
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api
# ── Docker / Producción: usa URL relativa (nginx hace el proxy) ──
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Puertos personalizados
POSTGRES_PORT=5432
BACKEND_PORT=8000
REDIS_PORT=6379
FRONTEND_PORT=80
