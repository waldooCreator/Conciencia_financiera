# ==========================================
# Variables de Entorno - Desarrollo Local
# ==========================================

# Django
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-2024
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
POSTGRES_DB=finanzas_db
POSTGRES_USER=finanzas_user
POSTGRES_PASSWORD=finanzas_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (para Django)
DATABASE_URL=postgres://finanzas_user:finanzas_password@db:5432/finanzas_db

# Redis (opcional, para Celery)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=jwt-dev-secret-key-change-in-production-2024
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Puertos personalizados
POSTGRES_PORT=5432
BACKEND_PORT=8000
REDIS_PORT=6379
FRONTEND_PORT=80
